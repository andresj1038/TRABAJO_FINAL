def mostrar_menu():
    print("\n========================================")
    print("              PET-VOZ")
    print("           GESTOR DE PQRS")
    print("========================================")
    print("1. Registrar PQRS")
    print("2. Consultar PQRS")
    print("3. Registrar cambio en PQRS")
    print("4. Estadísticas")
    print("5. Salir")
    print("========================================")


def iniciar_programa():
    opcion = ""

    while opcion != "5":
        mostrar_menu()
        opcion = input("Seleccione una opción: ")

        if opcion == "1":
            print("Registrar PQRS")

        elif opcion == "2":
            print("Consultar PQRS")

        elif opcion == "3":
            print("Registrar cambio en PQRS")

        elif opcion == "4":
            print("Estadísticas")

        elif opcion == "5":
            print("Gracias por utilizar Pet-Voz")

        else:
            print("Opción incorrecta, intente nuevamente")


iniciar_programa()
